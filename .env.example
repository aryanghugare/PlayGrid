PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=videoyoutube
CORS_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:8000
NODE_ENV=development
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SAME_SITE=lax
# local is for development; cloudinary is for hosted media.
MEDIA_DRIVER=local
MEDIA_DIRECTORY=data/media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET_KEY=
